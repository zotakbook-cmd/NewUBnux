# UBnux Cloudflare Pages headers
# HTML: always revalidate so deployments become visible quickly.
/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-cache

# Public master/index JSON: never serve a stale copy.
/assets/data/*.json
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# District business JSON: contact-free public data, always revalidate.
/assets/data/businesses/*.json
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# Apps Script/API responses: never cache.
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

# Static assets can be cached normally.
/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/images/*
  Cache-Control: public, max-age=86400
